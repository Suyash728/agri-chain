# Copy to .env for local development. Never commit .env.
# Hosted values go in the Render / Vercel dashboards instead (see DEPLOYMENT.md).

# ---------------- Backend (FastAPI) ----------------
# development (default): open CORS, all routes open.  production: see backend/settings.py
APP_ENV=development
# true = expose /demo/* and Admin writes without a token (default: true in dev, false in prod)
DEMO_MODE=
# production only: comma-separated frontend origins, e.g. https://agrichain.vercel.app
ALLOWED_ORIGINS=
ALLOWED_ORIGIN_REGEX=
# production: header X-Admin-Token for reset/seed/admin writes   (python -c "import secrets;print(secrets.token_urlsafe(32))")
ADMIN_API_TOKEN=
# header X-Device-Key for POST /telemetry(/batch); enforced whenever set, mandatory in production
DEVICE_API_KEY=

# Leave empty to use local SQLite (backend/agrichain.db). Supabase: use the *pooler* URI.
# WARNING: ./run.sh seeds with TRUNCATE; use --no-seed when this points at a real database.
DATABASE_URL=

# Chain: local Hardhat by default. Amoy: https://rpc-amoy.polygon.technology
RPC_URL=http://127.0.0.1:8545
# Local dev may use Hardhat account #0 (public!). Production refuses it.
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# Optional per-contract overrides (otherwise backend/modular-deployments.json is used)
PRODUCT_REGISTRY_ADDRESS=
CUSTODY_TRANSFER_ADDRESS=
COLD_CHAIN_MONITOR_ADDRESS=
POLICY_CONFIG_ADDRESS=
# Polygon needs >= ~25-30 gwei priority fee; 0 is fine for Hardhat
MIN_PRIORITY_FEE_GWEI=0
TX_RECEIPT_TIMEOUT=120

# IPFS pinning (without it documents get a local content hash, not a real IPFS CID)
PINATA_JWT=

# ---------------- Contracts (Hardhat) ----------------
AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# ---------------- Hardware bridge / simulators ----------------
AGRICHAIN_BACKEND_URL=http://localhost:8000
AGRICHAIN_DEVICE_KEY=

# ---------------- Frontend (Vite, build time) ----------------
# Set in frontend/.env.local or the Vercel dashboard
VITE_API_BASE_URL=http://localhost:8000
VITE_PRODUCT_REGISTRY_ADDRESS=
VITE_CUSTODY_TRANSFER_ADDRESS=
VITE_COLD_CHAIN_MONITOR_ADDRESS=
VITE_POLICY_CONFIG_ADDRESS=
